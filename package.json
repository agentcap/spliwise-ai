{
  "name": "splitwise-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "model:local": "bash scripts/finetuned-model.sh",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "node scripts/dev.mjs --production",
    "worker": "node --env-file-if-exists=.env.local --import tsx scripts/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:live": "node --env-file-if-exists=.env.local --import tsx scripts/live-smoke.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "backup": "node --env-file-if-exists=.env.local --import tsx scripts/backup.ts",
    "restore": "node --env-file-if-exists=.env.local --import tsx scripts/restore.ts",
    "validate:samples": "tsx scripts/validate-samples.ts",
    "db:migrate:all": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-all.ts",
    "backup:all": "node --env-file-if-exists=.env.local --import tsx scripts/backup-all.ts",
    "restore:all": "node --env-file-if-exists=.env.local --import tsx scripts/restore-all.ts",
    "maintenance": "node --env-file-if-exists=.env.local --import tsx scripts/maintenance.ts",
    "deletions": "node --env-file-if-exists=.env.local --import tsx scripts/deletions.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:assistant": "node --env-file-if-exists=.env.local --import tsx scripts/assistant-evaluate.ts",
    "test:eval": "node --env-file-if-exists=.env.local --import tsx scripts/evaluate.ts",
    "workspace:adopt": "node --env-file-if-exists=.env.local --import tsx scripts/adopt-workspace.ts",
    "test:production": "node scripts/production-smoke.mjs",
    "test:container": "node scripts/container-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@openai/agents": "0.20.0",
    "better-sqlite3": "13.0.3",
    "csv-parse": "7.0.3",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "openai": "7.41.0",
    "openid-client": "6.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "zod": "4.6.7",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
