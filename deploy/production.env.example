APP_MODE=production
APP_URL=https://splitwise.example.com
APP_DOMAIN=splitwise.example.com
# A confidential OIDC client using authorization code + PKCE.
# Register this EXACT redirect: https://splitwise.example.com/auth/callback
OIDC_ISSUER=https://your-identity-provider.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Exact, verified emails only. Removing an email also invalidates existing sessions.
OIDC_ALLOWED_EMAILS=you@example.com
SESSION_HOURS=12
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_AGENTS_DISABLE_TRACING=1
# REQUIRED when AI is enabled: copy current token prices for your model, in USD per million tokens.
# Do not copy these example local estimates into production without checking current prices.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
AI_MONTHLY_USER_USD=10
AI_MONTHLY_GLOBAL_USD=100
AI_MAX_OUTPUT_TOKENS=4096
MAX_JOB_TRANSACTIONS=1000
MAX_QUEUED_JOBS=5
JOB_TIMEOUT_SECONDS=180
MAX_JOB_ATTEMPTS=3
MIN_FREE_DISK_MB=256
CHAT_RETENTION_DAYS=90
# Generate: openssl rand -hex 32
OPS_TOKEN=
