# Separate credentials: these are available to the operations container only.
# Use an OFF-HOST repository. Initialize it once using restic init.
RESTIC_REPOSITORY=s3:https://s3.example.com/private-splitwise-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# The password file is mounted from ./secrets/restic-password.
# Save a recovery copy of this password separately from the server.
BACKUP_RETENTION_DAYS=30
