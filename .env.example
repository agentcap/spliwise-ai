APP_MODE=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_AGENTS_DISABLE_TRACING=1
# Optional fine-tuned model service: npm run model:local (same computer as the web server).
# FINETUNED_MODEL_PORT=8766
DATABASE_PATH=./data/splitwise.sqlite
# Optional local budgets (USD per calendar month, UTC).
AI_MONTHLY_USER_USD=10
AI_MONTHLY_GLOBAL_USD=100
# Set current per-million-token USD prices for meaningful cost estimates.
# Local mode uses placeholder allowances until both prices are configured.
# Production requires explicit prices when OPENAI_API_KEY is set.
# OPENAI_INPUT_USD_PER_MILLION=
# OPENAI_OUTPUT_USD_PER_MILLION=
# Automated tests only:
# AGENT_MODE=mock
